# Clave de API de Resend (https://resend.com) para enviar los correos
# de reserva a la empresa y de confirmación al cliente.
RESEND_API_KEY=

# Correo remitente verificado en Resend (debe ser de un dominio verificado)
RESEND_FROM_EMAIL="Cusco Walk <reservas@cuscowalk.com>"

# Correo de la empresa que recibe cada nueva reserva
COMPANY_NOTIFY_EMAIL=perucultour@gmail.com

# Opcional: si luego conectas Supabase para guardar las reservas
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
